<%- include("../head.partial.ejs") %>
<h1><%= title %></h1>
<form action="/login" method="POST">
    <input
      type="text"
      name="User_name"
      id="User_name"
      required
      minlength="3"
      maxlength="50"
      placeholder="Nazwa użytkownika"
      /><br>
          <input
      type="password"
      name="Password"
      id="Password"
      required
      minlength="3"
      maxlength="50"
      placeholder="Hasło"
      /><br>
      
    <button type="submit" class="loguj">Zaloguj</button>
  </form>
<%- include("../foot.partial.ejs") %>