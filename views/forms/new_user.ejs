<%- include("../head.partial.ejs") %>
<h1><%= title %></h1>
<% if(error){ %>
<div class="error">
  <%= error %>
</div>
<% } %>
<form action="/register" method="POST">
    <input
      type="text"
      name="User_name"
      id="User_name"
      required
      minlength="3"
      maxlength="50"
      placeholder="Nazwa użytkownika"
      /><br>
          <input
      type="password"
      name="Password"
      id="Password"
      required
      minlength="3"
      maxlength="50"
      placeholder="Hasło"
      /><br>
        <input
    type="password"
    name="ConfPass"
    placeholder="Potwierdź hasło"
    required
    /><br>
    <button type="submit" class="loguj">Utwórz</button>
  </form>
<%- include("../foot.partial.ejs") %>

